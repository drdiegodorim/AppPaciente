rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Global Catch-all safety net
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128;
    }

    // Patients collection rules
    match /patients/{patientId} {
      allow read, write: if isValidId(patientId);
    }

    // Logs collection rules
    match /logs/{logId} {
      allow read, write: if isValidId(logId);
    }

    // Medication Confirmations collection rules
    match /medicationConfirmations/{confirmationId} {
      allow read, write: if isValidId(confirmationId);
    }

    // Credentials collection rules
    match /credentials/{username} {
      allow read, write: if isValidId(username);
    }

    // Doctors collection rules
    match /doctors/{doctorId} {
      allow read, write: if isValidId(doctorId);
    }

    // Test connection collection rules
    match /test/{testId} {
      allow read, write: if isValidId(testId);
    }
  }
}
